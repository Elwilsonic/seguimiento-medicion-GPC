# Copiá este archivo como .env y ajustá los valores (CA-TEC05.8). Son valores
# de desarrollo: el .env real no se sube al repositorio.

# Base de datos que levanta docker compose.
POSTGRES_USER=gpc
POSTGRES_PASSWORD=gpc_dev
POSTGRES_DB=gpc
# Se usa 5433 para no chocar con un PostgreSQL instalado en el sistema, que
# normalmente usa el 5432.
POSTGRES_PORT=5433

# Aplicación: STORAGE es memory (por defecto) o postgres (CA-TEC05.4).
STORAGE=postgres
DATABASE_URL=postgres://gpc:gpc_dev@localhost:5433/gpc?sslmode=disable

# Pruebas de integración: la base tiene que terminar en _test. Si no está
# definida, los tests de PostgreSQL se omiten (CA-TEC05.7).
TEST_DATABASE_URL=postgres://gpc:gpc_dev@localhost:5433/gpc_test?sslmode=disable
